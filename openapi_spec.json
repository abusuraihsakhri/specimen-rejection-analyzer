{
  "openapi": "3.1.0",
  "info": {
    "title": "Specimen Rejection Analyzer API",
    "version": "3.0.0",
    "description": "Reference overview of the unvalidated, rule-based demonstration API. The live FastAPI /openapi.json endpoint is authoritative."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON operational counters and audit integrity status",
        "responses": {
          "200": {
            "description": "JSON counts and status"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate a demonstration task payload",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0
                  },
                  "status_descriptor": {
                    "type": "string",
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule-based evaluation dossier"
          },
          "422": {
            "description": "Input validation failure or recognized sensitive identifier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return a deterministic local mock response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "422": {
            "description": "Recognized sensitive identifier"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Inspect ephemeral audit blocks (access-controlled)",
        "parameters": [
          {
            "name": "X-Audit-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit blocks and signature verification result"
          },
          "403": {
            "description": "Missing or invalid token"
          },
          "503": {
            "description": "API_AUDIT_TOKEN is not configured"
          }
        }
      }
    }
  }
}
